{
  "name": "tare-standard",
  "private": true,
  "type": "module",
  "description": "The Tare Standard: the published Code of Points, and the site that publishes it.",
  "scripts": {
    "build": "tsx scripts/build-standard.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "editions:apparatus": "tsx scripts/editions-apparatus.ts",
    "deploy": "npm run build && wrangler deploy --config wrangler.standard.jsonc"
  },
  "dependencies": {
    "marked": "^18.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
