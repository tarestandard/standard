{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tare-standard-site",
  "compatibility_date": "2026-11-11",
  "routes": [{ "pattern": "tarestandard.org", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./standard-site/dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
